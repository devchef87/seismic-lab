# SeismicLab — Environment Variables
# Copy to .env and fill in your keys

# NASA API (free) — used for CME, solar flares, geomagnetic storms
# Register at https://api.nasa.gov/
# Falls back to DEMO_KEY with lower rate limits
NASA_API_KEY=DEMO_KEY

# NASA FIRMS (free) — thermal anomaly / wildfire data near volcanoes
# Register at https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=

# MapTiler (free tier) — satellite basemap tiles
# Register at https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=

# Mapbox (free tier) — high-res satellite basemap tiles
# Register at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# Email alerts (optional) — for notifications on significant events
# Only needed if you want email notifications via Gmail API
# GOOGLE_EMAIL_CLIENT_ID=
# GOOGLE_EMAIL_CLIENT_SECRET=
# GOOGLE_EMAIL_REFRESH_TOKEN=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
